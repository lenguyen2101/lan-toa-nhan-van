---
import { books, ebookTiers } from '../data/books';

const fmt = (n: number) => new Intl.NumberFormat('vi-VN').format(n) + 'đ';
---

<section class="section donation" id="dang-ky">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Đăng ký tặng sách</span>
      <h2 class="section-title">
        Trao tri thức<br />
        Góp <em>yêu thương</em>
      </h2>
      <p class="section-lead">
        Vui lòng chuyển khoản theo thông tin bên trái, sau đó điền form đăng ký để chúng tôi gửi sách đến bạn.
      </p>
    </div>

    <div class="donation-grid">
      <!-- LEFT: Payment info -->
      <aside class="payment-card">
        <h3 class="payment-title">Thông tin chuyển khoản</h3>

        <div class="bank-row">
          <span class="bank-label">Ngân hàng</span>
          <span class="bank-value">Ngân hàng TMCP Quân đội (MBBank)</span>
        </div>
        <div class="bank-row">
          <span class="bank-label">Số tài khoản</span>
          <span class="bank-value mono">3103</span>
        </div>
        <div class="bank-row">
          <span class="bank-label">Tên tài khoản</span>
          <span class="bank-value">QUY KHOI SU TU TAM</span>
        </div>
        <div class="bank-row">
          <span class="bank-label">Nội dung CK</span>
          <span class="bank-value mono">[Ho ten] TANG SACH</span>
        </div>

        <div class="qr-wrap">
          <button class="qr-btn" type="button" id="qr-zoom-btn" aria-label="Phóng to mã QR">
            <div class="qr-img-wrap">
              <img src="/images/QR3103.png" alt="Mã QR chuyển khoản" onerror="this.style.display='none'; this.parentElement.classList.add('no-qr');" />
              <div class="qr-fallback">
                <span>QR<br/>Code</span>
                <small>Tải lên ảnh QR vào<br/>/public/images/QR3103.png</small>
              </div>
            </div>
            <span class="qr-hint">Bấm để phóng to</span>
          </button>

          <a
            href="/images/QR3103.png"
            download="quy-khoi-su-tu-tam-qr.png"
            class="btn btn-secondary qr-download"
          >
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 2v9M4 7l4 4 4-4"/>
              <path d="M2 13v1.5h12V13"/>
            </svg>
            Tải QR về máy
          </a>
        </div>

        <p class="payment-note">
          Sau khi chuyển khoản, vui lòng điền form bên cạnh và bấm "Xác nhận đã chuyển khoản". Quỹ sẽ liên hệ các bạn để xác nhận trong vòng 1–2 ngày làm việc.
        </p>
      </aside>

      <!-- RIGHT: Form -->
      <form class="donation-form" id="donation-form" novalidate>
        <div class="field-row field-row-type-book" id="type-book-row">
          <div class="field" id="f-type-field" hidden>
            <label for="f-type-trigger">Hình thức ủng hộ *</label>
            <div class="custom-select" id="f-type-wrap" data-name="donationType">
              <button type="button" class="cs-trigger" id="f-type-trigger" aria-haspopup="listbox" aria-expanded="false">
                <span class="cs-value is-placeholder">-- Chọn hình thức --</span>
                <svg class="cs-arrow" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true">
                  <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
              </button>
              <ul class="cs-options" role="listbox" hidden>
                <li role="option" data-value="paper">Sách giấy</li>
                <li role="option" data-value="ebook">Ebook</li>
                <li role="option" data-value="both">Cả hai</li>
              </ul>
              <input type="hidden" name="donationType" value="paper" />
            </div>
            <small class="error" data-error-for="donationType"></small>
          </div>
          <div class="field">
            <label for="f-book-trigger">Cuốn sách quan tâm *</label>
            <div class="custom-select" id="f-book-wrap" data-name="book">
              <button type="button" class="cs-trigger" id="f-book-trigger" aria-haspopup="listbox" aria-expanded="false">
                <span class="cs-value is-placeholder">-- Chọn sách --</span>
                <svg class="cs-arrow" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true">
                  <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
              </button>
              <ul class="cs-options" role="listbox" hidden>
                {books.map((b) => (
                  <li role="option" data-value={b.id} data-paper-price={b.paperPrice}>{b.title}</li>
                ))}
              </ul>
              <input type="hidden" name="book" />
            </div>
            <small class="error" data-error-for="book"></small>
          </div>
        </div>

        <!-- Paper price box (editorial bookplate) -->
        <div class="paper-box" id="paper-box" hidden>
          <div class="paper-box-inner">
            <div class="paper-head">
              <span class="paper-eyebrow">
                <span class="ornament">✦</span>
                Ấn bản · Sách giấy
              </span>
              <span class="paper-edition">Tủ Sách Tri Thức · 2026</span>
            </div>

            <div class="paper-body">
              <div class="paper-left">
                <span class="paper-empty" id="paper-empty">
                  <em>Vui lòng chọn sách</em>
                  <small>để xem mức ủng hộ</small>
                </span>
              </div>
              <div class="paper-right">
                <span class="paper-price" id="paper-price-display" hidden></span>
                <span class="paper-price-currency" id="paper-price-currency" hidden>đồng</span>
              </div>
            </div>

          </div>
        </div>

        <!-- Ebook tiers box (editorial denomination cards) -->
        <div class="ebook-box" id="ebook-box" hidden>
          <div class="ebook-head">
            <span class="paper-eyebrow">
              <span class="ornament">✦</span>
              Ấn bản · Ebook
            </span>
            <span class="paper-edition">Tuỳ tâm · Mọi mức ủng hộ đều quý</span>
          </div>

          <div class="tier-grid">
            {ebookTiers.map((t) => (
              <label class="tier">
                <input type="radio" name="ebookTier" value={t} />
                <span class="tier-card">
                  <span class="tier-amount">{new Intl.NumberFormat('vi-VN').format(t / 1000)}</span>
                  <span class="tier-unit">Ngàn đồng</span>
                </span>
              </label>
            ))}
            <label class="tier tier-custom">
              <input type="radio" name="ebookTier" value="custom" />
              <span class="tier-card">
                <span class="tier-icon" aria-hidden="true">+</span>
                <span class="tier-unit">Số khác</span>
              </span>
            </label>
          </div>

          <div class="field custom-amount" id="custom-amount-wrap" hidden>
            <label for="f-custom">Nhập số tiền tuỳ tâm</label>
            <div class="amount-input-wrap">
              <input id="f-custom" name="customAmount" type="text" inputmode="numeric" autocomplete="off" placeholder="VD: 200,000" />
              <span class="amount-currency" aria-hidden="true">đ</span>
            </div>
          </div>
        </div>

        <!-- Total summary (only for "Cả hai" when both amounts present) -->
        <div class="total-box" id="total-box" hidden>
          <div class="total-inner">
            <div class="total-left">
              <span class="total-eyebrow">
                <span class="ornament">✦</span>
                Tổng cộng
              </span>
              <div class="total-breakdown">
                <span><span class="total-tag">Sách giấy</span><span class="total-num" id="total-paper">0</span><span class="total-unit">đ</span></span>
                <span class="total-plus">+</span>
                <span><span class="total-tag">Ebook</span><span class="total-num" id="total-ebook">0</span><span class="total-unit">đ</span></span>
              </div>
            </div>
            <div class="total-right">
              <span class="total-sum" id="total-sum">0</span>
              <span class="total-currency">đồng</span>
            </div>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="f-name">Họ và tên *</label>
            <input id="f-name" name="fullName" type="text" required autocomplete="name" placeholder="Nguyễn Văn A" />
            <small class="error" data-error-for="fullName"></small>
          </div>
          <div class="field">
            <label for="f-phone">Số điện thoại *</label>
            <input id="f-phone" name="phone" type="tel" required autocomplete="tel" placeholder="09xx xxx xxx" />
            <small class="error" data-error-for="phone"></small>
          </div>
        </div>

        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" placeholder="email@example.com" />
          <small class="error" data-error-for="email"></small>
        </div>

        <div class="field" id="address-field">
          <label for="f-address">Địa chỉ nhận sách *</label>
          <textarea id="f-address" name="address" rows="2" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"></textarea>
          <small class="error" data-error-for="address"></small>
        </div>

        <div class="field">
          <label for="f-note">Lời nhắn (không bắt buộc)</label>
          <textarea id="f-note" name="note" rows="2" placeholder="Nhập lời nhắn yêu thương"></textarea>
        </div>

        <button type="submit" class="btn btn-primary submit-btn" id="submit-btn">
          Xác nhận đã chuyển khoản
        </button>

        <p class="form-disclaimer">
          Bằng việc gửi form, bạn đồng ý cho Quỹ Khởi Sự Từ Tâm liên hệ qua thông tin trên để xác nhận quyên góp và gửi sách.
        </p>
      </form>
    </div>
  </div>

  <!-- Success modal -->
  <div class="modal" id="success-modal" hidden role="dialog" aria-modal="true">
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-panel success-panel">
      <div class="success-icon" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="64" height="64" fill="none">
          <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="3"/>
          <path d="M20 32 L28 40 L44 24" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3>Cảm ơn bạn đã đồng hành!</h3>
      <p class="success-msg" id="success-msg">
        Quỹ Khởi Sự Từ Tâm đã nhận được thông tin của bạn.
      </p>
      <div class="success-details">
        <p><strong>Sách giấy:</strong> Dự kiến nhận trong vòng <strong>5–7 ngày làm việc</strong>.</p>
        <p hidden><strong>Ebook:</strong> Đường link tải sẽ được gửi qua email trong vòng <strong>24 giờ</strong>.</p>
      </div>
      <button type="button" class="btn btn-primary" data-modal-close>Đã hiểu</button>
    </div>
  </div>

  <!-- QR zoom modal -->
  <div class="modal qr-modal" id="qr-modal" hidden role="dialog" aria-modal="true">
    <div class="modal-backdrop" data-modal-close></div>
    <div class="qr-zoom-panel">
      <button class="modal-close" data-modal-close aria-label="Đóng">×</button>
      <img src="/images/QR3103.png" alt="Mã QR chuyển khoản (phóng to)" onerror="this.style.display='none'; this.parentElement.classList.add('no-qr');" />
      <div class="qr-fallback-large">QR Code (placeholder)</div>
    </div>
  </div>
</section>

<script>
  // ---------- Custom select (combobox) ----------
  type CustomSelectAPI = {
    setValue: (value: string, label?: string) => void;
    getValue: () => string;
    getSelectedOption: () => HTMLLIElement | null;
  };
  const customSelects = new Map<string, CustomSelectAPI>();

  function setupCustomSelect(root: HTMLElement) {
    const name = root.dataset.name!;
    const trigger = root.querySelector('.cs-trigger') as HTMLButtonElement;
    const valueEl = root.querySelector('.cs-value') as HTMLElement;
    const placeholder = valueEl.textContent || '';
    const optionsEl = root.querySelector('.cs-options') as HTMLUListElement;
    const hidden = root.querySelector('input[type="hidden"]') as HTMLInputElement;
    const options = Array.from(optionsEl.querySelectorAll('[role="option"]')) as HTMLLIElement[];

    function open() {
      closeAllExcept(root);
      optionsEl.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      root.classList.add('open');
    }
    function close() {
      optionsEl.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      root.classList.remove('open');
    }
    function setValue(value: string, label?: string) {
      hidden.value = value;
      const opt = options.find((o) => o.dataset.value === value);
      const text = label ?? opt?.textContent ?? placeholder;
      valueEl.textContent = text;
      valueEl.classList.toggle('is-placeholder', !value);
      options.forEach((o) => o.setAttribute('aria-selected', o.dataset.value === value ? 'true' : 'false'));
      root.dispatchEvent(new CustomEvent('change', { bubbles: true }));
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      if (root.classList.contains('open')) close();
      else open();
    });
    options.forEach((opt) => {
      opt.addEventListener('click', () => {
        setValue(opt.dataset.value || '', opt.textContent || '');
        close();
        trigger.focus();
      });
    });
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (!root.classList.contains('open')) open();
        const first = options.find((o) => o.getAttribute('aria-selected') === 'true') || options[0];
        first?.focus();
      }
    });
    options.forEach((opt, i) => {
      opt.tabIndex = -1;
      opt.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          (options[i + 1] || options[0]).focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          (options[i - 1] || options[options.length - 1]).focus();
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setValue(opt.dataset.value || '', opt.textContent || '');
          close();
          trigger.focus();
        } else if (e.key === 'Escape') {
          close();
          trigger.focus();
        }
      });
    });

    customSelects.set(name, {
      setValue,
      getValue: () => hidden.value,
      getSelectedOption: () => options.find((o) => o.dataset.value === hidden.value) || null,
    });
  }

  function closeAllExcept(except?: Element) {
    document.querySelectorAll<HTMLElement>('.custom-select.open').forEach((el) => {
      if (el === except) return;
      el.classList.remove('open');
      const ul = el.querySelector<HTMLElement>('.cs-options');
      const tr = el.querySelector<HTMLElement>('.cs-trigger');
      if (ul) ul.hidden = true;
      tr?.setAttribute('aria-expanded', 'false');
    });
  }

  document.querySelectorAll<HTMLElement>('.custom-select').forEach(setupCustomSelect);
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.custom-select')) closeAllExcept();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllExcept();
  });

  // ---------- Form refs ----------
  const form = document.getElementById('donation-form') as HTMLFormElement | null;
  const typeSelect = customSelects.get('donationType');
  const bookSelect = customSelects.get('book');
  const typeWrap = document.getElementById('f-type-wrap');
  const bookWrap = document.getElementById('f-book-wrap');
  const paperBox = document.getElementById('paper-box');
  const ebookBox = document.getElementById('ebook-box');
  const paperPriceDisplay = document.getElementById('paper-price-display');
  const customAmountWrap = document.getElementById('custom-amount-wrap');
  const customAmountInput = document.getElementById('f-custom') as HTMLInputElement | null;
  const addressField = document.getElementById('address-field');


  const fmt = (n: number) => new Intl.NumberFormat('vi-VN').format(n) + 'đ';

  function updateAmountBoxes() {
    if (!typeSelect || !paperBox || !ebookBox) return;
    const t = typeSelect.getValue();
    paperBox.hidden = !(t === 'paper' || t === 'both');
    ebookBox.hidden = !(t === 'ebook' || t === 'both');

    if (addressField) {
      const paperRequired = t === 'paper' || t === 'both';
      addressField.classList.toggle('required', paperRequired);
    }
    updatePaperPrice();
    updateTotal();
  }

  function updatePaperPrice() {
    if (!bookSelect || !paperPriceDisplay) return;
    const opt = bookSelect.getSelectedOption();
    const price = opt?.getAttribute('data-paper-price');
    const paperEmpty = document.getElementById('paper-empty');
    const paperCurrency = document.getElementById('paper-price-currency');
    if (price) {
      paperPriceDisplay.textContent = new Intl.NumberFormat('vi-VN').format(parseInt(price, 10));
      paperPriceDisplay.hidden = false;
      if (paperCurrency) paperCurrency.hidden = false;
      if (paperEmpty) paperEmpty.hidden = true;
    } else {
      paperPriceDisplay.hidden = true;
      if (paperCurrency) paperCurrency.hidden = true;
      if (paperEmpty) paperEmpty.hidden = false;
    }
    updateTotal();
  }

  function updateTotal() {
    const totalBox = document.getElementById('total-box');
    if (!totalBox || !typeSelect || !bookSelect) return;

    if (typeSelect.getValue() !== 'both') {
      totalBox.hidden = true;
      return;
    }

    const paperPrice = Number(bookSelect.getSelectedOption()?.getAttribute('data-paper-price') || 0);
    const tierRadio = document.querySelector('input[name="ebookTier"]:checked') as HTMLInputElement | null;
    let ebookAmount = 0;
    if (tierRadio) {
      ebookAmount = tierRadio.value === 'custom'
        ? Number((customAmountInput?.value || '').replace(/[^0-9]/g, '') || 0)
        : Number(tierRadio.value || 0);
    }

    if (paperPrice <= 0 || ebookAmount <= 0) {
      totalBox.hidden = true;
      return;
    }

    const nf = new Intl.NumberFormat('vi-VN');
    const paperEl = document.getElementById('total-paper');
    const ebookEl = document.getElementById('total-ebook');
    const sumEl = document.getElementById('total-sum');
    if (paperEl) paperEl.textContent = nf.format(paperPrice);
    if (ebookEl) ebookEl.textContent = nf.format(ebookAmount);
    if (sumEl) sumEl.textContent = nf.format(paperPrice + ebookAmount);
    totalBox.hidden = false;
  }

  typeWrap?.addEventListener('change', updateAmountBoxes);
  bookWrap?.addEventListener('change', updatePaperPrice);

  // Ebook flow is paused (client hasn't prepared ebooks yet).
  // The donationType field is hidden — default it to "paper" so paper-box
  // shows automatically and validation treats this as paper-only.
  // Remove this when Ebook is brought back.
  typeSelect?.setValue('paper', 'Sách giấy');

  // Ebook tier radio
  document.querySelectorAll('input[name="ebookTier"]').forEach((r) => {
    r.addEventListener('change', (e) => {
      const v = (e.target as HTMLInputElement).value;
      if (customAmountWrap) customAmountWrap.hidden = v !== 'custom';
      if (v !== 'custom' && customAmountInput) customAmountInput.value = '';
      if (v === 'custom') setTimeout(() => customAmountInput?.focus(), 50);
      updateTotal();
    });
  });

  // Custom amount: format with thousand separators
  customAmountInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    const raw = target.value.replace(/[^0-9]/g, '');
    target.value = raw ? Number(raw).toLocaleString('en-US') : '';
    updateTotal();
  });

  // Listen to book:select from Books.astro
  document.addEventListener('book:select', (e: any) => {
    const { action, bookId, bookTitle } = e.detail;
    if (!typeSelect || !bookSelect || !typeWrap || !bookWrap) return;

    const typeValue = action === 'paper' ? 'paper' : 'ebook';
    const typeLabel = action === 'paper' ? 'Sách giấy' : 'Ebook';
    typeSelect.setValue(typeValue, typeLabel);
    bookSelect.setValue(bookId, bookTitle);
    updateAmountBoxes();

    [typeWrap, bookWrap].forEach((el) => {
      el.classList.add('highlight');
      setTimeout(() => el.classList.remove('highlight'), 1200);
    });
  });

  // Reset custom selects when form resets
  form?.addEventListener('reset', () => {
    setTimeout(() => {
      typeSelect?.setValue('');
      bookSelect?.setValue('');
      updateAmountBoxes();
    }, 0);
  });

  // ---------- Copy buttons ----------
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(text);
        const hint = btn.querySelector('.copy-hint');
        if (hint) {
          const original = hint.textContent;
          hint.textContent = 'Đã sao chép ✓';
          setTimeout(() => { hint.textContent = original; }, 1500);
        }
      } catch {}
    });
  });

  // ---------- QR zoom ----------
  const qrModal = document.getElementById('qr-modal');
  document.getElementById('qr-zoom-btn')?.addEventListener('click', () => {
    if (!qrModal) return;
    qrModal.hidden = false;
    setTimeout(() => qrModal.classList.add('open'), 10);
    document.body.style.overflow = 'hidden';
  });

  // ---------- Modal close (success + qr) ----------
  function closeModalEl(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove('open');
    setTimeout(() => {
      el.hidden = true;
      document.body.style.overflow = '';
    }, 200);
  }
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#success-modal [data-modal-close]')) closeModalEl(document.getElementById('success-modal'));
    if (target.closest('#qr-modal [data-modal-close]')) closeModalEl(document.getElementById('qr-modal'));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    closeModalEl(document.getElementById('success-modal'));
    closeModalEl(document.getElementById('qr-modal'));
  });

  // ---------- Validation ----------
  function setError(name: string, msg: string) {
    const el = document.querySelector(`[data-error-for="${name}"]`);
    if (el) el.textContent = msg;
  }
  function clearErrors() {
    document.querySelectorAll('[data-error-for]').forEach((el) => (el.textContent = ''));
  }

  function validate(data: FormData): string | null {
    clearErrors();
    let firstError: string | null = null;

    const required = (key: string, label: string) => {
      const v = (data.get(key) || '').toString().trim();
      if (!v) {
        setError(key, `Vui lòng nhập ${label}.`);
        firstError ??= key;
        return false;
      }
      return true;
    };

    required('fullName', 'họ và tên');

    const phone = (data.get('phone') || '').toString().trim();
    if (!phone) {
      setError('phone', 'Vui lòng nhập số điện thoại.');
      firstError ??= 'phone';
    } else if (!/^(0|\+84)\d{8,10}$/.test(phone.replace(/\s/g, ''))) {
      setError('phone', 'Số điện thoại không hợp lệ (VD: 0901234567).');
      firstError ??= 'phone';
    }

    const type = (data.get('donationType') || '').toString();
    if (!type) {
      setError('donationType', 'Vui lòng chọn hình thức ủng hộ.');
      firstError ??= 'donationType';
    }

    const email = (data.get('email') || '').toString().trim();
    const emailRequired = type === 'ebook' || type === 'both';
    if (emailRequired && !email) {
      setError('email', 'Vui lòng nhập email.');
      firstError ??= 'email';
    } else if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setError('email', 'Email không hợp lệ.');
      firstError ??= 'email';
    }

    const book = (data.get('book') || '').toString();
    if (!book) {
      setError('book', 'Vui lòng chọn cuốn sách.');
      firstError ??= 'book';
    }

    if (type === 'paper' || type === 'both') {
      const address = (data.get('address') || '').toString().trim();
      if (!address) {
        setError('address', 'Vui lòng nhập địa chỉ nhận sách.');
        firstError ??= 'address';
      }
    }

    return firstError;
  }

  // ---------- Submit ----------
  // Replace these endpoints with real values from Quỹ:
  const GOOGLE_SHEETS_ENDPOINT = 'https://script.google.com/macros/s/AKfycbxrlHTR0PYSXxQklxg6HjBneAQCA-Biyavgxw0UZLCOKU7HLOJnKCtdHjurPfC8HtgU/exec';
  const EMAIL_ENDPOINT = '';         // e.g. Formspree: 'https://formspree.io/f/xxxxxx'

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const firstError = validate(data);
    if (firstError) {
      const field = document.querySelector(`[name="${firstError}"]`) as HTMLElement | null;
      // Hidden inputs (custom selects) — focus their visible trigger instead
      const focusTarget =
        field && (field as HTMLInputElement).type === 'hidden'
          ? (field.closest('.custom-select')?.querySelector('.cs-trigger') as HTMLElement | null)
          : field;
      focusTarget?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      focusTarget?.focus();
      return;
    }

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Đang gửi...';
    }

    const payload: Record<string, any> = {};
    data.forEach((v, k) => (payload[k] = v));
    // Normalize: strip thousand separators from customAmount
    if (payload.customAmount) {
      payload.customAmount = String(payload.customAmount).replace(/[^0-9]/g, '');
    }

    const donationType = String(payload.donationType || '');
    const includesPaper = donationType === 'paper' || donationType === 'both';
    const includesEbook = donationType === 'ebook' || donationType === 'both';

    const paperPrice = includesPaper
      ? Number(bookSelect?.getSelectedOption()?.getAttribute('data-paper-price') || 0)
      : 0;

    let ebookAmount = 0;
    if (includesEbook) {
      const tier = String(payload.ebookTier || '');
      ebookAmount = tier === 'custom' ? Number(payload.customAmount || 0) : Number(tier || 0);
    }

    payload.paperPrice = paperPrice;
    payload.totalAmount = paperPrice + ebookAmount;

    payload.submittedAt = new Date().toISOString();
    payload.source = 'tang-sach-landing';

    // Tracking
    if (typeof (window as any).fbq === 'function') {
      (window as any).fbq('track', 'Donate', { content_name: payload.book, value: payload.customAmount || 0 });
    }
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'donation_submit', payload);
    }

    try {
      const tasks: Promise<any>[] = [];
      if (GOOGLE_SHEETS_ENDPOINT) {
        tasks.push(
          fetch(GOOGLE_SHEETS_ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          })
        );
      }
      if (EMAIL_ENDPOINT) {
        tasks.push(
          fetch(EMAIL_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          })
        );
      }
      if (tasks.length === 0) {
        // No endpoint yet — log for dev visibility
        console.log('[donation-form] No backend endpoints configured. Payload:', payload);
      }
      await Promise.allSettled(tasks);

      // Show success
      const successMsg = document.getElementById('success-msg');
      if (successMsg) {
        const bookLabel = bookSelect?.getSelectedOption()?.textContent || '';
        successMsg.textContent = `Cảm ơn ${payload.fullName}! Quỹ đã ghi nhận ủng hộ "${bookLabel}" của bạn.`;
      }
      const successModal = document.getElementById('success-modal');
      if (successModal) {
        successModal.hidden = false;
        setTimeout(() => successModal.classList.add('open'), 10);
        document.body.style.overflow = 'hidden';
      }
      form.reset();
      updateAmountBoxes();
    } catch (err) {
      console.error(err);
      alert('Có lỗi xảy ra khi gửi. Vui lòng thử lại hoặc liên hệ Quỹ qua hotline 0933 039 678.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Xác nhận đã chuyển khoản';
      }
    }
  });
</script>

