---
import { books, ebookTiers } from '../data/books';

const fmt = (n: number) => new Intl.NumberFormat('vi-VN').format(n) + 'đ';
---

<section class="section donation" id="dang-ky">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Đăng ký tặng sách</span>
      <h2 class="section-title">
        Trao <em>tri thức</em><br />
        Góp <em>yêu thương</em>
      </h2>
      <p class="section-lead">
        Vui lòng chuyển khoản theo thông tin bên dưới, sau đó điền form đăng ký để chúng tôi gửi sách đến bạn.
      </p>
    </div>

    <div class="donation-grid">
      <!-- LEFT: Payment info -->
      <aside class="payment-card">
        <h3 class="payment-title">Thông tin chuyển khoản</h3>

        <div class="bank-row">
          <span class="bank-label">Ngân hàng</span>
          <span class="bank-value">Ngân hàng TMCP Quân đội (MBBank)</span>
        </div>
        <div class="bank-row">
          <span class="bank-label">Số tài khoản</span>
          <span class="bank-value mono">3103</span>
        </div>
        <div class="bank-row">
          <span class="bank-label">Tên tài khoản</span>
          <span class="bank-value">QUY KHOI SU TU TAM</span>
        </div>
        <div class="bank-row">
          <span class="bank-label">Nội dung CK</span>
          <span class="bank-value mono">[Ho ten] TANG SACH</span>
        </div>

        <div class="qr-wrap">
          <button class="qr-btn" type="button" id="qr-zoom-btn" aria-label="Phóng to mã QR">
            <div class="qr-img-wrap">
              <img src="/images/QR3103.png" alt="Mã QR chuyển khoản" onerror="this.style.display='none'; this.parentElement.classList.add('no-qr');" />
              <div class="qr-fallback">
                <span>QR<br/>Code</span>
                <small>Tải lên ảnh QR vào<br/>/public/images/QR3103.png</small>
              </div>
            </div>
            <span class="qr-hint">Bấm để phóng to</span>
          </button>

          <a
            href="/images/QR3103.png"
            download="quy-khoi-su-tu-tam-qr.png"
            class="btn btn-secondary qr-download"
          >
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 2v9M4 7l4 4 4-4"/>
              <path d="M2 13v1.5h12V13"/>
            </svg>
            Tải QR về máy
          </a>
        </div>

        <p class="payment-note">
          Sau khi chuyển khoản, vui lòng điền form bên cạnh và bấm "Xác nhận đã chuyển khoản". Quỹ sẽ liên hệ các bạn để xác nhận trong vòng 1–2 ngày làm việc.
        </p>
      </aside>

      <!-- RIGHT: Form -->
      <form class="donation-form" id="donation-form" novalidate>
        <!-- Hidden donation type (ebook flow paused) — kept so old logic still has a value. -->
        <input type="hidden" name="donationType" value="paper" id="f-donation-type" />

        <!-- Book picker: multi-select with quantity (1–10 per book) -->
        <div class="field book-picker-field" id="f-books-field">
          <label class="book-picker-label">Chọn sách ủng hộ *</label>
          <ul class="book-picker">
            {books.map((b) => (
              <li class="book-picker-item" data-book-id={b.id} data-price={b.paperPrice}>
                <label class="bp-row">
                  <input type="checkbox" class="bp-check" value={b.id} />
                  <span class="bp-info">
                    <span class="bp-title">{b.title}</span>
                    <span class="bp-price">{fmt(b.paperPrice)}</span>
                  </span>
                </label>
                <div class="bp-stepper" hidden>
                  <button type="button" class="bp-minus" aria-label={`Giảm số lượng ${b.title}`}>−</button>
                  <input
                    type="number"
                    class="bp-qty"
                    inputmode="numeric"
                    value="1"
                    min="1"
                    max="99"
                    aria-label={`Số lượng ${b.title}`}
                  />
                  <button type="button" class="bp-plus" aria-label={`Tăng số lượng ${b.title}`}>+</button>
                </div>
              </li>
            ))}
          </ul>
          <small class="error" data-error-for="items"></small>
        </div>

        <!-- Cart summary: appears when ≥1 book is selected -->
        <div class="cart-box" id="cart-box" hidden>
          <div class="cart-inner">
            <div class="cart-head">
              <span class="cart-eyebrow">
                <span class="ornament">✦</span>
                Danh sách đã chọn
              </span>
            </div>
            <ul class="cart-items" id="cart-items"></ul>
            <div class="cart-total-row">
              <span class="cart-total-label">Tổng (<span id="cart-count">0</span> cuốn)</span>
              <span class="cart-total-amount">
                <span class="cart-total-value" id="cart-total-value">0</span>
                <span class="cart-total-currency">đ</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Ebook tiers box — flow paused, kept for future re-enable. -->
        <div class="ebook-box" id="ebook-box" hidden>
          <div class="ebook-head">
            <span class="paper-eyebrow">
              <span class="ornament">✦</span>
              Ấn bản · Ebook
            </span>
            <span class="paper-edition">Tuỳ tâm · Mọi mức ủng hộ đều quý</span>
          </div>

          <div class="tier-grid">
            {ebookTiers.map((t) => (
              <label class="tier">
                <input type="radio" name="ebookTier" value={t} />
                <span class="tier-card">
                  <span class="tier-amount">{new Intl.NumberFormat('vi-VN').format(t / 1000)}</span>
                  <span class="tier-unit">Ngàn đồng</span>
                </span>
              </label>
            ))}
            <label class="tier tier-custom">
              <input type="radio" name="ebookTier" value="custom" />
              <span class="tier-card">
                <span class="tier-icon" aria-hidden="true">+</span>
                <span class="tier-unit">Số khác</span>
              </span>
            </label>
          </div>

          <div class="field custom-amount" id="custom-amount-wrap" hidden>
            <label for="f-custom">Nhập số tiền tuỳ tâm</label>
            <div class="amount-input-wrap">
              <input id="f-custom" name="customAmount" type="text" inputmode="numeric" autocomplete="off" placeholder="VD: 200,000" />
              <span class="amount-currency" aria-hidden="true">đ</span>
            </div>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="f-name">Họ và tên *</label>
            <input id="f-name" name="fullName" type="text" required autocomplete="name" placeholder="Nguyễn Văn A" />
            <small class="error" data-error-for="fullName"></small>
          </div>
          <div class="field">
            <label for="f-phone">Số điện thoại *</label>
            <input id="f-phone" name="phone" type="tel" required autocomplete="tel" placeholder="09xx xxx xxx" />
            <small class="error" data-error-for="phone"></small>
          </div>
        </div>

        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" placeholder="email@example.com" />
          <small class="error" data-error-for="email"></small>
        </div>

        <div class="field" id="address-field">
          <label for="f-address">Địa chỉ nhận sách *</label>
          <textarea id="f-address" name="address" rows="2" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"></textarea>
          <small class="error" data-error-for="address"></small>
        </div>

        <div class="field">
          <label for="f-note">Lời nhắn (không bắt buộc)</label>
          <textarea id="f-note" name="note" rows="2" placeholder="Nhập lời nhắn yêu thương"></textarea>
        </div>

        <button type="submit" class="btn btn-primary submit-btn" id="submit-btn">
          Xác nhận đã chuyển khoản
        </button>

        <p class="form-disclaimer">
          Bằng việc gửi form, bạn đồng ý cho Quỹ Khởi Sự Từ Tâm liên hệ qua thông tin trên để xác nhận quyên góp và gửi sách.
        </p>
      </form>
    </div>
  </div>

  <!-- Success modal -->
  <div class="modal" id="success-modal" hidden role="dialog" aria-modal="true">
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-panel success-panel">
      <div class="success-icon" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="64" height="64" fill="none">
          <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="3"/>
          <path d="M20 32 L28 40 L44 24" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3>Cảm ơn bạn đã đồng hành!</h3>
      <p class="success-msg" id="success-msg">
        Quỹ Khởi Sự Từ Tâm đã nhận được thông tin của bạn.
      </p>
      <div class="success-details">
        <p><strong>Sách giấy:</strong> Dự kiến nhận trong vòng <strong>5–7 ngày làm việc</strong>.</p>
        <p hidden><strong>Ebook:</strong> Đường link tải sẽ được gửi qua email trong vòng <strong>24 giờ</strong>.</p>
      </div>
      <button type="button" class="btn btn-primary" data-modal-close>Đã hiểu</button>
    </div>
  </div>

  <!-- QR zoom modal -->
  <div class="modal qr-modal" id="qr-modal" hidden role="dialog" aria-modal="true">
    <div class="modal-backdrop" data-modal-close></div>
    <div class="qr-zoom-panel">
      <button class="modal-close" data-modal-close aria-label="Đóng">×</button>
      <img src="/images/QR3103.png" alt="Mã QR chuyển khoản (phóng to)" onerror="this.style.display='none'; this.parentElement.classList.add('no-qr');" />
      <div class="qr-fallback-large">QR Code (placeholder)</div>
    </div>
  </div>
</section>

<script>
  // ---------- Custom select (combobox) ----------
  type CustomSelectAPI = {
    setValue: (value: string, label?: string) => void;
    getValue: () => string;
    getSelectedOption: () => HTMLLIElement | null;
  };
  const customSelects = new Map<string, CustomSelectAPI>();

  function setupCustomSelect(root: HTMLElement) {
    const name = root.dataset.name!;
    const trigger = root.querySelector('.cs-trigger') as HTMLButtonElement;
    const valueEl = root.querySelector('.cs-value') as HTMLElement;
    const placeholder = valueEl.textContent || '';
    const optionsEl = root.querySelector('.cs-options') as HTMLUListElement;
    const hidden = root.querySelector('input[type="hidden"]') as HTMLInputElement;
    const options = Array.from(optionsEl.querySelectorAll('[role="option"]')) as HTMLLIElement[];

    function open() {
      closeAllExcept(root);
      optionsEl.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      root.classList.add('open');
    }
    function close() {
      optionsEl.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      root.classList.remove('open');
    }
    function setValue(value: string, label?: string) {
      hidden.value = value;
      const opt = options.find((o) => o.dataset.value === value);
      const text = label ?? opt?.textContent ?? placeholder;
      valueEl.textContent = text;
      valueEl.classList.toggle('is-placeholder', !value);
      options.forEach((o) => o.setAttribute('aria-selected', o.dataset.value === value ? 'true' : 'false'));
      root.dispatchEvent(new CustomEvent('change', { bubbles: true }));
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      if (root.classList.contains('open')) close();
      else open();
    });
    options.forEach((opt) => {
      opt.addEventListener('click', () => {
        setValue(opt.dataset.value || '', opt.textContent || '');
        close();
        trigger.focus();
      });
    });
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (!root.classList.contains('open')) open();
        const first = options.find((o) => o.getAttribute('aria-selected') === 'true') || options[0];
        first?.focus();
      }
    });
    options.forEach((opt, i) => {
      opt.tabIndex = -1;
      opt.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          (options[i + 1] || options[0]).focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          (options[i - 1] || options[options.length - 1]).focus();
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setValue(opt.dataset.value || '', opt.textContent || '');
          close();
          trigger.focus();
        } else if (e.key === 'Escape') {
          close();
          trigger.focus();
        }
      });
    });

    customSelects.set(name, {
      setValue,
      getValue: () => hidden.value,
      getSelectedOption: () => options.find((o) => o.dataset.value === hidden.value) || null,
    });
  }

  function closeAllExcept(except?: Element) {
    document.querySelectorAll<HTMLElement>('.custom-select.open').forEach((el) => {
      if (el === except) return;
      el.classList.remove('open');
      const ul = el.querySelector<HTMLElement>('.cs-options');
      const tr = el.querySelector<HTMLElement>('.cs-trigger');
      if (ul) ul.hidden = true;
      tr?.setAttribute('aria-expanded', 'false');
    });
  }

  document.querySelectorAll<HTMLElement>('.custom-select').forEach(setupCustomSelect);
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.custom-select')) closeAllExcept();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllExcept();
  });

  // ---------- Form refs ----------
  const form = document.getElementById('donation-form') as HTMLFormElement | null;
  const booksField = document.getElementById('f-books-field');
  const cartBox = document.getElementById('cart-box');
  const cartItems = document.getElementById('cart-items');
  const cartCount = document.getElementById('cart-count');
  const cartTotalValue = document.getElementById('cart-total-value');
  const addressField = document.getElementById('address-field');

  const fmt = (n: number) => new Intl.NumberFormat('vi-VN').format(n) + 'đ';
  const MAX_QTY = 99;

  // ---------- Book picker (multi-select + quantity) ----------
  type BookEntry = { title: string; price: number };
  const bookCatalog = new Map<string, BookEntry>();
  document.querySelectorAll<HTMLLIElement>('.book-picker-item').forEach((item) => {
    const id = item.dataset.bookId!;
    const price = Number(item.dataset.price || 0);
    const title = item.querySelector('.bp-title')?.textContent?.trim() || id;
    bookCatalog.set(id, { title, price });
  });

  // State: bookId -> quantity (only entries with qty >= 1 are "selected").
  const cart = new Map<string, number>();

  // Pure state update — no DOM side effects on the picker row.
  function setCartQty(bookId: string, qty: number) {
    const n = Math.max(0, Math.min(MAX_QTY, Math.floor(qty)));
    if (n <= 0) cart.delete(bookId);
    else cart.set(bookId, n);
  }

  // Sync row UI (checkbox, stepper visibility, qty input value) with cart state.
  // Skip this while the user is actively typing in the input — hiding the
  // stepper would yank focus and dismiss the mobile keyboard.
  function syncRowUI(bookId: string) {
    const item = document.querySelector<HTMLLIElement>(`.book-picker-item[data-book-id="${bookId}"]`);
    if (!item) return;
    const n = cart.get(bookId) || 0;
    const check = item.querySelector<HTMLInputElement>('.bp-check');
    const stepper = item.querySelector<HTMLElement>('.bp-stepper');
    const qtyInput = item.querySelector<HTMLInputElement>('.bp-qty');
    if (check) check.checked = n > 0;
    if (stepper) stepper.hidden = n <= 0;
    if (qtyInput) qtyInput.value = n > 0 ? String(n) : '1';
    item.classList.toggle('is-selected', n > 0);
  }

  // Full update: state + UI + cart summary.
  function setQty(bookId: string, qty: number, opts: { skipRender?: boolean } = {}) {
    setCartQty(bookId, qty);
    syncRowUI(bookId);
    if (!opts.skipRender) renderCart();
  }

  function renderCart() {
    if (!cartBox || !cartItems || !cartCount || !cartTotalValue) return;
    cartItems.innerHTML = '';
    let totalQty = 0;
    let totalAmount = 0;
    cart.forEach((qty, bookId) => {
      const entry = bookCatalog.get(bookId);
      if (!entry) return;
      const lineTotal = entry.price * qty;
      totalQty += qty;
      totalAmount += lineTotal;
      const li = document.createElement('li');
      li.className = 'cart-item';
      li.innerHTML = `
        <span class="cart-item-qty">x${qty}</span>
        <span class="cart-item-title">${entry.title}</span>
        <span class="cart-item-total">${new Intl.NumberFormat('vi-VN').format(lineTotal)}đ</span>
      `;
      cartItems.appendChild(li);
    });
    cartCount.textContent = String(totalQty);
    cartTotalValue.textContent = new Intl.NumberFormat('vi-VN').format(totalAmount);
    cartBox.hidden = totalQty === 0;
  }

  // Wire up each book row
  document.querySelectorAll<HTMLLIElement>('.book-picker-item').forEach((item) => {
    const id = item.dataset.bookId!;
    const check = item.querySelector<HTMLInputElement>('.bp-check')!;
    const minus = item.querySelector<HTMLButtonElement>('.bp-minus')!;
    const plus = item.querySelector<HTMLButtonElement>('.bp-plus')!;
    const qtyInput = item.querySelector<HTMLInputElement>('.bp-qty')!;

    check.addEventListener('change', () => {
      setQty(id, check.checked ? 1 : 0);
    });
    minus.addEventListener('click', () => {
      const current = cart.get(id) || 0;
      setQty(id, current - 1);
    });
    plus.addEventListener('click', () => {
      const current = cart.get(id) || 0;
      setQty(id, current + 1);
    });
    qtyInput.addEventListener('input', () => {
      // Update cart silently while typing — don't touch row UI (would
      // dismiss the mobile numeric keyboard if stepper gets hidden).
      const raw = qtyInput.value.replace(/[^0-9]/g, '');
      const n = raw ? parseInt(raw, 10) : 0;
      setCartQty(id, n);
      renderCart();
    });
    qtyInput.addEventListener('blur', () => {
      // Commit on blur: collapse stepper if qty went to 0; otherwise sync
      // the input display in case the typed value exceeded MAX_QTY (and got
      // clamped silently in setCartQty).
      const current = cart.get(id) || 0;
      if (current <= 0) {
        syncRowUI(id);
        renderCart();
      } else {
        qtyInput.value = String(current);
      }
    });
  });

  // Listen to book:select from Books.astro — adds 1 of that book to cart and scrolls to form.
  document.addEventListener('book:select', (e: any) => {
    const { bookId } = e.detail || {};
    if (!bookId || !bookCatalog.has(bookId)) return;
    const current = cart.get(bookId) || 0;
    setQty(bookId, current + 1);
    const item = document.querySelector<HTMLElement>(`.book-picker-item[data-book-id="${bookId}"]`);
    if (item) {
      item.classList.add('highlight');
      setTimeout(() => item.classList.remove('highlight'), 1200);
    }
  });

  // Reset wipes the cart too
  form?.addEventListener('reset', () => {
    setTimeout(() => {
      Array.from(cart.keys()).forEach((id) => setQty(id, 0, { skipRender: true }));
      cart.clear();
      renderCart();
    }, 0);
  });

  // ---------- Copy buttons ----------
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(text);
        const hint = btn.querySelector('.copy-hint');
        if (hint) {
          const original = hint.textContent;
          hint.textContent = 'Đã sao chép ✓';
          setTimeout(() => { hint.textContent = original; }, 1500);
        }
      } catch {}
    });
  });

  // ---------- QR zoom ----------
  const qrModal = document.getElementById('qr-modal');
  document.getElementById('qr-zoom-btn')?.addEventListener('click', () => {
    if (!qrModal) return;
    qrModal.hidden = false;
    setTimeout(() => qrModal.classList.add('open'), 10);
    document.body.style.overflow = 'hidden';
  });

  // ---------- Modal close (success + qr) ----------
  function closeModalEl(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove('open');
    setTimeout(() => {
      el.hidden = true;
      document.body.style.overflow = '';
    }, 200);
  }
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#success-modal [data-modal-close]')) closeModalEl(document.getElementById('success-modal'));
    if (target.closest('#qr-modal [data-modal-close]')) closeModalEl(document.getElementById('qr-modal'));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    closeModalEl(document.getElementById('success-modal'));
    closeModalEl(document.getElementById('qr-modal'));
  });

  // ---------- Validation ----------
  function setError(name: string, msg: string) {
    const el = document.querySelector(`[data-error-for="${name}"]`);
    if (el) el.textContent = msg;
  }
  function clearErrors() {
    document.querySelectorAll('[data-error-for]').forEach((el) => (el.textContent = ''));
  }

  function validate(data: FormData): string | null {
    clearErrors();
    let firstError: string | null = null;

    const required = (key: string, label: string) => {
      const v = (data.get(key) || '').toString().trim();
      if (!v) {
        setError(key, `Vui lòng nhập ${label}.`);
        firstError ??= key;
        return false;
      }
      return true;
    };

    required('fullName', 'họ và tên');

    const phone = (data.get('phone') || '').toString().trim();
    if (!phone) {
      setError('phone', 'Vui lòng nhập số điện thoại.');
      firstError ??= 'phone';
    } else if (!/^(0|\+84)\d{8,10}$/.test(phone.replace(/\s/g, ''))) {
      setError('phone', 'Số điện thoại không hợp lệ (VD: 0901234567).');
      firstError ??= 'phone';
    }

    const email = (data.get('email') || '').toString().trim();
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setError('email', 'Email không hợp lệ.');
      firstError ??= 'email';
    }

    if (cart.size === 0) {
      setError('items', 'Vui lòng chọn ít nhất 1 cuốn sách.');
      firstError ??= 'items';
    }

    const address = (data.get('address') || '').toString().trim();
    if (!address) {
      setError('address', 'Vui lòng nhập địa chỉ nhận sách.');
      firstError ??= 'address';
    }

    return firstError;
  }

  // ---------- Submit ----------
  // Replace these endpoints with real values from Quỹ:
  const GOOGLE_SHEETS_ENDPOINT = 'https://script.google.com/macros/s/AKfycbxrlHTR0PYSXxQklxg6HjBneAQCA-Biyavgxw0UZLCOKU7HLOJnKCtdHjurPfC8HtgU/exec';
  const EMAIL_ENDPOINT = '';         // e.g. Formspree: 'https://formspree.io/f/xxxxxx'

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const firstError = validate(data);
    if (firstError) {
      let focusTarget: HTMLElement | null = null;
      if (firstError === 'items') {
        focusTarget = booksField;
      } else {
        focusTarget = document.querySelector(`[name="${firstError}"]`);
      }
      focusTarget?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      focusTarget?.focus?.();
      return;
    }

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Đang gửi...';
    }

    const items = Array.from(cart.entries()).map(([bookId, qty]) => {
      const entry = bookCatalog.get(bookId);
      return {
        bookId,
        qty,
        title: entry?.title,
        price: entry?.price,
      };
    });
    const totalCount = items.reduce((s, it) => s + it.qty, 0);
    const totalAmount = items.reduce((s, it) => s + (it.price || 0) * it.qty, 0);

    const payload: Record<string, any> = {
      fullName: (data.get('fullName') || '').toString().trim(),
      phone: (data.get('phone') || '').toString().trim(),
      email: (data.get('email') || '').toString().trim(),
      address: (data.get('address') || '').toString().trim(),
      note: (data.get('note') || '').toString().trim(),
      donationType: (data.get('donationType') || 'paper').toString(),
      items,
      totalCount,
      totalAmount,
      submittedAt: new Date().toISOString(),
      source: 'tang-sach-landing',
    };

    // Tracking
    if (typeof (window as any).fbq === 'function') {
      (window as any).fbq('track', 'Donate', { num_items: totalCount, value: totalAmount });
    }
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'donation_submit', payload);
    }

    try {
      const tasks: Promise<any>[] = [];
      if (GOOGLE_SHEETS_ENDPOINT) {
        tasks.push(
          fetch(GOOGLE_SHEETS_ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          })
        );
      }
      if (EMAIL_ENDPOINT) {
        tasks.push(
          fetch(EMAIL_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          })
        );
      }
      if (tasks.length === 0) {
        // No endpoint yet — log for dev visibility
        console.log('[donation-form] No backend endpoints configured. Payload:', payload);
      }
      await Promise.allSettled(tasks);

      // Show success
      const successMsg = document.getElementById('success-msg');
      if (successMsg) {
        successMsg.textContent = `Cảm ơn ${payload.fullName}! Quỹ đã ghi nhận đơn ủng hộ ${totalCount} cuốn sách của bạn.`;
      }
      const successModal = document.getElementById('success-modal');
      if (successModal) {
        successModal.hidden = false;
        setTimeout(() => successModal.classList.add('open'), 10);
        document.body.style.overflow = 'hidden';
      }
      form.reset();
    } catch (err) {
      console.error(err);
      alert('Có lỗi xảy ra khi gửi. Vui lòng thử lại hoặc liên hệ Quỹ qua hotline 0933 039 678.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Xác nhận đã chuyển khoản';
      }
    }
  });
</script>

