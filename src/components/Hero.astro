<section class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="eyebrow">Trao tri thức — Góp yêu thương</span>

      <h1 class="hero-headline">
        <span class="line-1">Đọc để <em class="em-hieu">hiểu</em>.</span>
        <span class="line-2">Hiểu để <em class="em-lam">làm</em>.</span>
        <span class="line-3">Làm để <em class="em-thay-doi">thay đổi</em>.</span>
      </h1>

      <div class="hero-meta">
        <p class="hero-lead">
          Mỗi cuốn sách được trao đi không chỉ lan toả tri thức thiện nguyện, mà còn góp thêm nguồn lực để những hành động tử tế tạo ra thay đổi thiết thực cho cộng đồng.
        </p>
        <div class="hero-cta">
          <a href="#chon-sach" class="btn btn-primary">Chọn sách ủng hộ →</a>
          <a href="#du-an" class="btn btn-ghost">Tìm hiểu các dự án</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg);
    background-image: url("/images/KV%20resize%20ladipage%20for%20PC.png");
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    min-height: clamp(520px, 50vw, 760px);
    padding-top: clamp(32px, 4vw, 64px);
    padding-bottom: clamp(48px, 6vw, 96px);
    display: flex;
    align-items: center;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(250, 244, 232, 0.92) 0%,
      rgba(250, 244, 232, 0.75) 32%,
      rgba(250, 244, 232, 0.35) 54%,
      transparent 72%
    );
    pointer-events: none;
    z-index: 1;
  }
  /* Fade hero's bottom edge to transparent so body bg shows through —
     no color band, seamless transition into next section. */
  .hero {
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black calc(100% - 64px), transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, black calc(100% - 64px), transparent 100%);
  }
  .hero-inner {
    width: 100%;
    position: relative;
    z-index: 2;
  }

  /* ---- Copy column ---- */
  .hero-copy {
    max-width: 540px;
    display: flex;
    flex-direction: column;
  }
  .hero-headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: normal;
    font-size: clamp(34px, 4.6vw, 64px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text-ink);
    margin: 16px 0 28px;
    text-shadow: 0 1px 0 rgba(250, 244, 232, 0.6);
  }
  .hero-headline .line-1,
  .hero-headline .line-2,
  .hero-headline .line-3 {
    display: block;
  }
  .hero-headline em {
    font-style: italic;
    font-weight: 600;
    position: relative;
  }
  .hero-headline .em-hieu { color: var(--color-teal-dark); }
  .hero-headline .em-lam { color: var(--color-blue-dark); }
  .hero-headline .em-thay-doi { color: var(--color-primary-dark); }

  .hero-meta {
    border-top: 1px solid var(--color-rule);
    padding-top: 20px;
    max-width: 480px;
  }
  .hero-lead {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 20px;
  }
  .hero-cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .hero {
      min-height: clamp(420px, 56vw, 600px);
    }
    .hero-copy {
      max-width: 480px;
    }
  }
  @media (max-width: 768px) {
    .hero {
      background-image: url("/images/KV%20resize%20ladipage%20for%20Mobile.png");
      background-position: bottom center;
      background-size: cover;
      min-height: 200vw;
      align-items: flex-start;
      padding-top: 16px;
      padding-bottom: 24px;
    }
    .hero::before {
      background: linear-gradient(
        to bottom,
        rgba(250, 244, 232, 0.92) 0%,
        rgba(250, 244, 232, 0.78) 28%,
        rgba(250, 244, 232, 0.55) 42%,
        rgba(250, 244, 232, 0.2) 58%,
        transparent 70%
      );
    }
    .hero {
      -webkit-mask-image: linear-gradient(to bottom, black 0%, black calc(100% - 44px), transparent 100%);
      mask-image: linear-gradient(to bottom, black 0%, black calc(100% - 44px), transparent 100%);
    }
    .hero-copy {
      max-width: none;
    }
    .hero-meta {
      max-width: 100%;
      padding-top: 14px;
    }
    .hero-headline {
      font-size: clamp(28px, 8.4vw, 40px);
      line-height: 1.15;
      margin: 10px 0 16px;
    }
    .hero-lead {
      margin-bottom: 14px;
      font-size: 15px;
    }
    .hero .eyebrow {
      font-size: 11px;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }
    .hero-cta .btn-ghost {
      background-color: rgba(250, 244, 232, 0.85);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      box-shadow: 0 4px 14px rgba(42, 36, 25, 0.08);
    }
  }
  @media (max-width: 600px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .hero-cta .btn {
      width: 100%;
      padding: 16px 24px;
    }
  }
</style>
