---
import { partners } from '../data/partners';

// Duplicate the list for the mobile marquee. CSS hides the second half on desktop.
const partnersRow = [...partners, ...partners];
---

<section class="section partners" id="dong-hanh">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">
        Đơn vị <em>đồng hành</em>
      </h2>
      <p class="section-lead">
        Hành trình lan toả tri thức không thể trọn vẹn nếu thiếu sự sát cánh của các đơn vị bảo trợ, xuất bản và truyền thông.
      </p>
    </div>

    <div class="partners-grid">
      {partnersRow.map((p, idx) => {
        const isClone = idx >= partners.length;
        return (
          <div
            class={`partner-tile${isClone ? ' is-clone' : ''}`}
            title={p.name}
            aria-hidden={isClone ? 'true' : undefined}
          >
            <div class="partner-logo-wrap">
              <img src={p.logo} alt={p.name} loading="lazy" onerror="this.style.display='none'; this.parentElement.classList.add('no-img');" />
              <span class="partner-fallback" aria-hidden="true">{p.name.split(' ').map(w => w[0]).join('').slice(0,2)}</span>
            </div>
            <span class="partner-name">{p.name}</span>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .partners {
    background: var(--color-bg-alt);
    position: relative;
  }
  .partners::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: var(--color-rule);
  }
  .partners::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: var(--color-rule);
  }
  .section-head {
    text-align: center;
    margin-bottom: 48px;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-head .section-title em {
    color: var(--color-primary-dark);
    font-style: italic;
  }
  .section-head .section-lead {
    margin-left: auto;
    margin-right: auto;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px 20px;
    align-items: start;
  }

  .partner-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .partner-logo-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    padding: 14px 18px;
  }
  .partner-logo-wrap:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .partner-logo-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 2;
    position: relative;
  }
  .partner-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 20px;
    color: var(--color-primary);
    z-index: 1;
  }
  .partner-logo-wrap.no-img .partner-fallback {
    display: flex;
  }
  .partner-name {
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  /* Desktop / tablet: clones hidden, only originals shown in grid. */
  .partner-tile.is-clone {
    display: none;
  }

  @media (max-width: 900px) {
    .partners-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 560px) {
    /* Mobile: GPU-accelerated marquee. Same pattern as testimonial track. */
    .partners {
      overflow: hidden;
    }
    .partners-grid {
      display: flex;
      grid-template-columns: none;
      width: max-content;
      gap: 14px;
      margin: 0 -20px;
      padding: 4px 0 4px 20px;
      animation: scroll-left-partners 32s linear infinite;
    }
    .partners-grid:hover,
    .partners-grid:focus-within {
      animation-play-state: paused;
    }
    .partner-tile,
    .partner-tile.is-clone {
      display: flex;
      flex: 0 0 46vw;
    }
    .partner-logo-wrap {
      padding: 12px 14px;
    }
  }

  @keyframes scroll-left-partners {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 7px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-grid { animation: none; }
  }
</style>
