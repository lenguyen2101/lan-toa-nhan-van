---
import { partners } from '../data/partners';
---

<section class="section partners" id="dong-hanh">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">
        Đơn vị <em>đồng hành</em>
      </h2>
      <p class="section-lead">
        Hành trình lan toả tri thức không thể trọn vẹn nếu thiếu sự sát cánh của các đơn vị bảo trợ, xuất bản và truyền thông.
      </p>
    </div>

    <div class="partners-grid">
      {partners.map((p) => (
        <div class="partner-tile" title={p.name}>
          <div class="partner-logo-wrap">
            <img src={p.logo} alt={p.name} loading="lazy" onerror="this.style.display='none'; this.parentElement.classList.add('no-img');" />
            <span class="partner-fallback" aria-hidden="true">{p.name.split(' ').map(w => w[0]).join('').slice(0,2)}</span>
          </div>
          <span class="partner-name">{p.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partners {
    background: var(--color-bg-alt);
    position: relative;
  }
  .partners::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: var(--color-rule);
  }
  .partners::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: var(--color-rule);
  }
  .section-head {
    text-align: center;
    margin-bottom: 48px;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-head .section-title em {
    color: var(--color-primary-dark);
    font-style: italic;
  }
  .section-head .section-lead {
    margin-left: auto;
    margin-right: auto;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px 20px;
    align-items: start;
  }

  .partner-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .partner-logo-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    padding: 14px 18px;
  }
  .partner-logo-wrap:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .partner-logo-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    z-index: 2;
    position: relative;
  }
  .partner-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 20px;
    color: var(--color-primary);
    z-index: 1;
  }
  .partner-logo-wrap.no-img .partner-fallback {
    display: flex;
  }
  .partner-name {
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .partners-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 560px) {
    .partners-grid {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: 14px;
      margin-left: -20px;
      margin-right: -20px;
      padding: 4px 20px;
    }
    .partners-grid::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
      background: transparent;
    }
    .partners-grid::-webkit-scrollbar-thumb,
    .partners-grid::-webkit-scrollbar-track {
      background: transparent;
      display: none;
    }
    .partner-tile {
      flex: 0 0 46%;
    }
    .partner-logo-wrap {
      padding: 12px 14px;
    }
  }
</style>

<script>
  // Auto-scroll the partners carousel on mobile only.
  // Uses cloned tiles for seamless infinite loop (no rewind animation).
  // Pauses when user touches, resumes after idle.
  const grid = document.querySelector<HTMLElement>('#dong-hanh .partners-grid');
  if (grid) {
    const mqMobile = window.matchMedia('(max-width: 560px)');
    const mqReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const SPEED = 18; // pixels per second — slow
    const RESUME_DELAY = 2500;

    let rafId: number | null = null;
    let lastTime = 0;
    let accumulator = 0;
    let paused = false;
    let resumeTimer: number | null = null;
    let clones: HTMLElement[] = [];
    let loopWidth = 0;

    function setupClones() {
      removeClones();
      const originals = Array.from(grid!.children) as HTMLElement[];
      originals.forEach((child) => {
        const clone = child.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.classList.add('is-clone');
        clone.querySelectorAll<HTMLElement>('a, button').forEach((el) => el.setAttribute('tabindex', '-1'));
        grid!.appendChild(clone);
        clones.push(clone);
      });
      loopWidth = clones[0]?.offsetLeft ?? 0;
    }

    function removeClones() {
      clones.forEach((c) => c.remove());
      clones = [];
      loopWidth = 0;
    }

    function step(now: number) {
      if (!grid) return;
      if (!lastTime) lastTime = now;
      const dt = (now - lastTime) / 1000;
      lastTime = now;

      if (!paused) {
        accumulator += SPEED * dt;
        const px = Math.floor(accumulator);
        if (px > 0) {
          let next = grid.scrollLeft + px;
          if (loopWidth > 0 && next >= loopWidth) {
            next -= loopWidth;
          }
          grid.scrollLeft = next;
          accumulator -= px;
        }
      }
      rafId = requestAnimationFrame(step);
    }

    function start() {
      if (rafId !== null) return;
      setupClones();
      lastTime = 0;
      accumulator = 0;
      rafId = requestAnimationFrame(step);
    }
    function stop() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      removeClones();
    }

    function shouldRun() {
      return mqMobile.matches && !mqReduceMotion.matches;
    }

    if (shouldRun()) start();

    mqMobile.addEventListener('change', () => {
      if (shouldRun()) start();
      else stop();
    });
    mqReduceMotion.addEventListener('change', () => {
      if (shouldRun()) start();
      else stop();
    });

    window.addEventListener('resize', () => {
      if (clones.length > 0) {
        loopWidth = clones[0]?.offsetLeft ?? 0;
      }
    });

    const pauseAndScheduleResume = () => {
      paused = true;
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => { paused = false; }, RESUME_DELAY);
    };
    grid.addEventListener('touchstart', pauseAndScheduleResume, { passive: true });
    grid.addEventListener('touchmove', pauseAndScheduleResume, { passive: true });
  }
</script>
