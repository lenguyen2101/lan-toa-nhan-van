---
import { books } from '../data/books';

// Duplicate the book list to keep the marquee continuous on wide screens.
const row1 = [...books, ...books, ...books];
const row2 = [...books.slice().reverse(), ...books.slice().reverse(), ...books.slice().reverse()];

// Pre-computed rotation values (deterministic so SSR matches client)
const rotations = [-8, 6, -4, 9, -7, 5, -3, 8, -6, 4, -9, 7, -5, 3, -8, 6, -4, 9];
---

<section class="explore-more">
  <div class="container">
    <div class="explore-card">
      <div class="explore-left">
        <span class="eyebrow">
          <span class="ornament">✦</span>
          Khám phá thêm
        </span>
        <h2 class="explore-headline">
          Còn nhiều<br />
          <em>hành trình thiện nguyện</em> đang chờ bạn.
        </h2>
        <p class="explore-lead">
          Quỹ Khởi Sự Từ Tâm liên tục mở rộng dự án, sách hay và chương trình kết nối cộng đồng. Ghé thăm website chính thức để cùng đồng hành.
        </p>
        <a href="https://quykhoisututam.com/" class="btn btn-primary explore-cta" target="_blank" rel="noopener">
          Tham quan website Quỹ
          <svg viewBox="0 0 16 12" width="16" height="12" aria-hidden="true">
            <path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="explore-right" aria-hidden="true">
        <div class="book-marquee">
          <div class="book-row row-1">
            {row1.map((book, i) => (
              <div class="float-book" style={`--rot: ${rotations[i % rotations.length]}deg`}>
                <img src={book.cover} alt="" loading="lazy" onerror="this.parentElement.classList.add('no-img')" />
                <div class="float-fallback">
                  <span>{book.title}</span>
                </div>
              </div>
            ))}
          </div>
          <div class="book-row row-2">
            {row2.map((book, i) => (
              <div class="float-book" style={`--rot: ${rotations[(i + 3) % rotations.length] * -1}deg`}>
                <img src={book.cover} alt="" loading="lazy" onerror="this.parentElement.classList.add('no-img')" />
                <div class="float-fallback">
                  <span>{book.title}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Edge fade masks -->
        <div class="fade-left" aria-hidden="true"></div>
        <div class="fade-right" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .explore-more {
    padding: clamp(48px, 6vw, 80px) 0 clamp(48px, 6vw, 80px);
    position: relative;
  }

  .explore-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: stretch;
    box-shadow: 0 24px 56px rgba(42, 36, 25, 0.10);
  }

  .explore-left {
    padding: clamp(36px, 5vw, 60px) clamp(28px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    z-index: 2;
    background: linear-gradient(90deg, var(--color-surface) 88%, transparent 100%);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
    margin-bottom: 0;
  }
  .eyebrow::before, .eyebrow::after { display: none; }
  .eyebrow .ornament {
    font-size: 14px;
    color: var(--color-primary);
  }

  .explore-headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-text-ink);
    margin: 0;
  }
  .explore-headline em {
    font-style: italic;
    color: var(--color-primary-dark);
  }

  .explore-lead {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 420px;
    margin: 0;
  }

  .explore-cta {
    align-self: flex-start;
    margin-top: 6px;
    padding: 14px 22px;
  }
  .explore-cta svg {
    transition: transform 0.2s ease;
  }
  .explore-cta:hover svg {
    transform: translateX(3px);
  }

  /* ---- Right: floating book marquee ---- */
  .explore-right {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-alt);
    min-height: 360px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    padding: 32px 0;
  }

  .book-marquee {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .book-row {
    display: flex;
    gap: 22px;
    width: max-content;
    will-change: transform;
  }
  .row-1 {
    animation: scroll-left 60s linear infinite;
  }
  .row-2 {
    animation: scroll-right 75s linear infinite;
    margin-left: -120px;
  }

  @keyframes scroll-left {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% / 3)); }
  }
  @keyframes scroll-right {
    from { transform: translateX(calc(-100% / 3)); }
    to { transform: translateX(0); }
  }

  .explore-right:hover .book-row {
    animation-play-state: paused;
  }

  .float-book {
    flex-shrink: 0;
    width: 110px;
    aspect-ratio: 3 / 4;
    border-radius: 3px;
    overflow: hidden;
    background: var(--color-text-ink);
    box-shadow:
      0 8px 18px rgba(42, 36, 25, 0.18),
      0 2px 5px rgba(42, 36, 25, 0.08);
    transform: rotate(var(--rot, 0deg));
    transition: transform 0.3s ease;
    position: relative;
  }
  .float-book:hover {
    transform: rotate(0) scale(1.06);
    box-shadow: 0 16px 32px rgba(42, 36, 25, 0.24);
  }
  .float-book img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .float-book.no-img img { display: none; }
  .float-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-pink) 100%);
    color: white;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14px;
    line-height: 1.2;
    z-index: 0;
  }
  .float-book:not(.no-img) .float-fallback { display: none; }

  /* Edge fade masks for soft entry/exit */
  .fade-left, .fade-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 3;
    pointer-events: none;
  }
  .fade-left {
    left: 0;
    background: linear-gradient(90deg, var(--color-bg-alt) 0%, transparent 100%);
  }
  .fade-right {
    right: 0;
    background: linear-gradient(270deg, var(--color-bg-alt) 0%, transparent 100%);
  }

  @media (max-width: 900px) {
    .explore-card {
      grid-template-columns: 1fr;
    }
    .explore-right {
      min-height: 280px;
    }
    .explore-left {
      background: var(--color-surface);
    }
    .float-book {
      width: 90px;
    }
  }
  @media (max-width: 560px) {
    .explore-right {
      min-height: 240px;
      padding: 24px 0;
    }
    .book-marquee { gap: 18px; }
    .float-book { width: 80px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-1, .row-2 { animation: none; }
  }
</style>
