---
import { projects } from '../data/projects';
---

<section class="section projects" id="du-an">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Các dự án trọng điểm</span>
      <h2 class="section-title">
        Quỹ <em>Khởi Sự Từ Tâm</em>
      </h2>
      <p class="section-lead">
        Được thành lập theo QĐ số 3039/QĐ của UBND tỉnh Bình Dương, nay trực thuộc quản lý của Sở Nội Vụ — UBND Thành phố Hồ Chí Minh. Số tiền gây quỹ từ hoạt động tặng sách sẽ được gửi đến các hoàn cảnh khó khăn trong dự án.
      </p>
    </div>

    <div class="projects-grid">
      {projects.map((p) => (
        <a class="project-card" href={p.url} target="_blank" rel="noopener" style={`--accent:${p.accent}`}>
          <div class="project-media" aria-hidden="true">
            <img src={p.image} alt="" loading="lazy" onerror="this.style.display='none'; this.parentElement.classList.add('no-img');" />
            <div class="project-tint"></div>
          </div>
          <div class="project-body">
            <h3 class="project-name">{p.name}</h3>
            <p class="project-desc">{p.description}</p>
            <span class="project-link">
              Tìm hiểu thêm
              <svg viewBox="0 0 16 12" width="16" height="12" aria-hidden="true">
                <path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    background: transparent;
  }
  .section-head {
    text-align: center;
    margin-bottom: 56px;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-head .section-title em {
    color: var(--color-primary-dark);
    font-style: italic;
  }
  .section-head .section-lead {
    margin-left: auto;
    margin-right: auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
  }
  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgba(42, 36, 25, 0.18);
  }

  .project-media {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background-color: var(--accent);
  }
  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15) contrast(1.02);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
    z-index: 1;
    position: relative;
  }
  .project-card:hover .project-media img {
    transform: scale(1.06);
    filter: grayscale(0) contrast(1.05);
  }
  .project-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 25%, transparent) 0%,
      color-mix(in srgb, var(--accent) 50%, transparent) 50%,
      color-mix(in srgb, var(--accent) 88%, transparent) 100%
    );
    z-index: 2;
    transition: opacity 0.4s ease;
    mix-blend-mode: multiply;
  }
  .project-card:hover .project-tint {
    opacity: 0.7;
  }
  .project-body {
    padding: 22px 22px 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .project-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    font-style: italic;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
    color: var(--color-text-ink);
  }
  .project-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin-bottom: 18px;
    flex: 1;
  }
  .project-link {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.2s ease;
  }
  .project-card:hover .project-link {
    gap: 12px;
  }

  @media (max-width: 1000px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .projects-grid {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: 14px;
      margin-left: -20px;
      margin-right: -20px;
      padding: 4px 20px;
    }
    .projects-grid::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
      background: transparent;
    }
    .projects-grid::-webkit-scrollbar-thumb,
    .projects-grid::-webkit-scrollbar-track {
      background: transparent;
      display: none;
    }
    .project-card {
      flex: 0 0 78%;
    }
    .project-media { aspect-ratio: 2 / 1; }
  }
</style>

<script>
  // Auto-scroll the project carousel on mobile only.
  // Uses cloned cards for seamless infinite loop (no rewind animation).
  // Pauses when user touches, resumes after idle.
  const grid = document.querySelector<HTMLElement>('#du-an .projects-grid');
  if (grid) {
    const mqMobile = window.matchMedia('(max-width: 560px)');
    const mqReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const SPEED = 22; // pixels per second
    const RESUME_DELAY = 2500;

    let rafId: number | null = null;
    let lastTime = 0;
    let accumulator = 0;
    let paused = false;
    let resumeTimer: number | null = null;
    let clones: HTMLElement[] = [];
    let loopWidth = 0;

    function setupClones() {
      removeClones();
      const originals = Array.from(grid!.children) as HTMLElement[];
      originals.forEach((child) => {
        const clone = child.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.classList.add('is-clone');
        clone.querySelectorAll<HTMLElement>('a, button').forEach((el) => el.setAttribute('tabindex', '-1'));
        grid!.appendChild(clone);
        clones.push(clone);
      });
      // Distance to scroll before wrap-around equals position of first clone.
      loopWidth = clones[0]?.offsetLeft ?? 0;
    }

    function removeClones() {
      clones.forEach((c) => c.remove());
      clones = [];
      loopWidth = 0;
    }

    function step(now: number) {
      if (!grid) return;
      if (!lastTime) lastTime = now;
      const dt = (now - lastTime) / 1000;
      lastTime = now;

      if (!paused) {
        accumulator += SPEED * dt;
        const px = Math.floor(accumulator);
        if (px > 0) {
          let next = grid.scrollLeft + px;
          if (loopWidth > 0 && next >= loopWidth) {
            next -= loopWidth; // instant wrap — clone content matches start
          }
          grid.scrollLeft = next;
          accumulator -= px;
        }
      }
      rafId = requestAnimationFrame(step);
    }

    function start() {
      if (rafId !== null) return;
      setupClones();
      lastTime = 0;
      accumulator = 0;
      rafId = requestAnimationFrame(step);
    }
    function stop() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      removeClones();
    }

    function shouldRun() {
      return mqMobile.matches && !mqReduceMotion.matches;
    }

    if (shouldRun()) start();

    mqMobile.addEventListener('change', () => {
      if (shouldRun()) start();
      else stop();
    });
    mqReduceMotion.addEventListener('change', () => {
      if (shouldRun()) start();
      else stop();
    });

    // Recompute loopWidth on resize (card widths change with viewport).
    window.addEventListener('resize', () => {
      if (clones.length > 0) {
        loopWidth = clones[0]?.offsetLeft ?? 0;
      }
    });

    const pauseAndScheduleResume = () => {
      paused = true;
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => { paused = false; }, RESUME_DELAY);
    };
    grid.addEventListener('touchstart', pauseAndScheduleResume, { passive: true });
    grid.addEventListener('touchmove', pauseAndScheduleResume, { passive: true });
  }
</script>
